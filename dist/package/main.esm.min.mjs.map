var wrapAgTestIdFor = (fn) => {
  const locators = {};
  const keys = Object.keys(agTestIdFor);
  keys.forEach((k) => {
    locators[k] = (...args) => {
      return fn(agTestIdFor[k](...args));
    };
  });
